# OPTIONAL: the workbench and offline demos work with everything below left blank.
# Copy to .env only if you have an approved LLM endpoint and authorization.
LN_LLM_ENABLED=false
LN_LLM_BASE_URL=
LN_LLM_API_KEY=
LN_LLM_MODEL=
# Remote HTTPS calls require explicit consent; localhost HTTP is allowed.
LN_LLM_ALLOW_EXTERNAL=false
